{
  "comment": "Reliability-tax sweep. Budget axis = DeepSeek's official thinking mode + reasoning_effort levels (NOT max_tokens). max_tokens is only a safety cap to avoid truncation. Results are reported against REALIZED reasoning tokens.",

  "models": [
    {"name": "deepseek-flash",   "provider": "deepseek", "family": "DeepSeek", "model_id": "deepseek-flash"},
    {"name": "deepseek-v4-pro",  "provider": "deepseek", "family": "DeepSeek", "model_id": "deepseek-v4-pro"},
    {"name": "qwen3-32b",        "provider": "dashscope",  "family": "Qwen3",  "thinking": true},
    {"name": "glm-4.6",          "provider": "zhipu",      "family": "GLM",    "thinking": true},
    {"name": "doubao-seed",      "provider": "volcengine", "family": "Doubao", "model_id": "REPLACE_WITH_ARK_ENDPOINT_ID"}
  ],

  "budgets": [
    {"name": "off",  "thinking": "disabled", "max_tokens": 8192},
    {"name": "low",  "thinking": "enabled",  "reasoning_effort": "low",  "max_tokens": 32768},
    {"name": "high", "thinking": "enabled",  "reasoning_effort": "high", "max_tokens": 32768},
    {"name": "max",  "thinking": "enabled",  "reasoning_effort": "max",  "max_tokens": 32768}
  ],

  "tasks": [
    {"name": "math",         "file": "gsm8k.jsonl",        "n": 200},
    {"name": "factqa",       "file": "nq.jsonl",           "n": 200},
    {"name": "multihop",     "file": "hotpotqa.jsonl",     "n": 200},
    {"name": "falsepremise", "file": "falsepremise.jsonl", "n": 200}
  ],

  "sampling": {"k": 4, "temperature": 0.7},
  "templates": ["plain", "strict"],

  "paths": {"data": "data", "runs": "runs", "results": "results", "logs": "logs"},
  "run": {"concurrency": 8, "timeout": 300, "max_retries": 3}
}
